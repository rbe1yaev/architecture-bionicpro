        <mxCell id="d-e2" edge="1" parent="1" source="d-ui" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" target="d-bff" value="2. GET /reports?from&amp;to&lt;br&gt;cookie сессии, без токенов">
