        <mxCell id="d-e1" edge="1" parent="1" source="d-pilot" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" target="d-ui" value="1. Нажимает&lt;br&gt;«Получить отчёт»">
          <mxGeometry relative="1" as="geometry" />
