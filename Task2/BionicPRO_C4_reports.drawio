        </mxCell>
        <mxCell id="d-e4" edge="1" parent="1" source="d-bff" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;" target="d-kc" value="4. Если истёк:&lt;br&gt;grant_type=refresh_token">
