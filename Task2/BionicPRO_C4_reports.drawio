        </mxCell>
        <mxCell id="d-e5" edge="1" parent="1" source="d-bff" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#1F7A52;fontColor=#1F7A52;strokeWidth=2;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" target="d-reports" value="5. GET /reports&lt;br&gt;Authorization: Bearer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d-e6" edge="1" parent="1" source="d-reports" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#1F7A52;fontColor=#1F7A52;strokeWidth=2;" target="d-kc" value="6. JWKS (кэш): подпись, exp, aud,&lt;br&gt;роль prothetic_user&lt;br&gt;нет/невалиден → 401, нет роли → 403">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d-e7" edge="1" parent="1" source="d-reports" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#1F7A52;fontColor=#1F7A52;strokeWidth=2;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" target="d-ch" value="7. SELECT processed_until FROM etl_watermark&lt;br&gt;to := min(to, processed_until)&lt;br&gt;8. SELECT … FROM reports_mart&lt;br&gt;WHERE user_id = preferred_username(JWT)&lt;br&gt;AND report_date BETWEEN from AND to">
