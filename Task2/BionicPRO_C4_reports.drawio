        </mxCell>
        <mxCell id="d-e10" edge="1" parent="1" source="d-bff" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" target="d-ui" value="10. JSON отчёта">
